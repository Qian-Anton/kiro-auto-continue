<!-- The window, laid out after the sketch the user approved: three pages (sessions, phone, settings). Every
     row sizes to its text (grids, wrap panels, wrapping text), so nothing overlaps at any display scale or in
     either language. ASCII only: the words are set from words.<lang>.ui in MainWindow.xaml.cs. -->
<Window x:Class="KiroAutoContinue.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="680" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="White" Foreground="#111827"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary Source="Theme.xaml"/>
  </Window.Resources>

  <TabControl x:Name="pages" Style="{StaticResource Tabs}">

    <!-- 1. sessions -->
    <TabItem x:Name="tabSessions">
      <Grid x:Name="sessPage" Margin="24,18,24,16" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- what the watcher is doing, as in the sketch's green card -->
        <Border x:Name="statusCard" CornerRadius="10" BorderThickness="1" Padding="18,13,14,13" Background="#ECFDF5" BorderBrush="#A7F3D0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,14,0">
              <Ellipse x:Name="statusHalo" Fill="#10B981" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
              <Ellipse x:Name="statusDot" Fill="#10B981" Width="10" Height="10"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="statusTitle" FontSize="16" FontWeight="Bold" Foreground="#065F46" TextWrapping="Wrap"/>
              <TextBlock x:Name="statusSummary" FontSize="12.5" Foreground="#047857" Margin="0,3,0,0" TextWrapping="Wrap"/>
              <!-- the credits as Kiro last saw them (Credits.cs); hidden until Kiro has asked -->
              <TextBlock x:Name="statusCredits" FontSize="12.5" Foreground="#047857" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
            <Button x:Name="pauseBtn" Grid.Column="2" Style="{StaticResource Btn}" BorderBrush="#6EE7B7" Foreground="#065F46"
                    Margin="14,0,0,0" VerticalAlignment="Center" Click="OnPause"/>
          </Grid>
        </Border>

        <!-- the column heads; as wide as the list's viewport so they stay over their columns -->
        <Grid Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Left" Width="{Binding ViewportWidth, ElementName=listScroll}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="St"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Act"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="colNum" FontSize="12" Foreground="{StaticResource Ink500}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
          <TextBlock x:Name="colSession" Grid.Column="1" FontSize="12" Foreground="{StaticResource Ink500}" Margin="0,0,14,8" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="colState" Grid.Column="2" FontSize="12" Foreground="{StaticResource Ink500}" Margin="0,0,16,8"/>
          <Border Grid.ColumnSpan="4" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom"/>
        </Grid>

        <ScrollViewer x:Name="listScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl x:Name="list" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="row" Background="Transparent" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="St"/>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Act"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Ink700}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                      <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource Ink900}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                      <TextBlock FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Workspace, Mode=OneWay}" Foreground="{StaticResource Ink400}"/><Run Text="{Binding Extra, Mode=OneWay}" Foreground="#7C3AED"/>
                      </TextBlock>
                    </StackPanel>
                    <!-- at most PillMax wide (a share of the list's width, set in code); a longer state wraps -->
                    <Border x:Name="pill" Grid.Column="2" CornerRadius="11" Padding="10,3,10,4" Margin="0,0,16,0" MinWidth="64"
                            MaxWidth="{DynamicResource PillMax}" Background="#F3F4F6" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock x:Name="pillText" Text="{Binding StateText}" FontSize="12" Foreground="#4B5563" HorizontalAlignment="Center"
                                 TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource BtnRow}" Content="{Binding ActionText}" IsEnabled="{Binding ActionEnabled}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRowAction"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="row" Property="Background" Value="#F9FAFB"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding Kind}" Value="running">
                    <Setter TargetName="pill" Property="Background" Value="#DBEAFE"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="#1D4ED8"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="pending">
                    <Setter TargetName="pill" Property="Background" Value="#FFEDD5"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="#C2410C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="needs">
                    <Setter TargetName="pill" Property="Background" Value="#FEE2E2"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="#B91C1C"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="goal">
                    <Setter TargetName="pill" Property="Background" Value="#DCFCE7"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="#15803D"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="cut">
                    <Setter TargetName="pill" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="#92400E"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="restart">
                    <Setter TargetName="pill" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="pillText" Property="Foreground" Value="#92400E"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="emptyText" Grid.Row="2" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed"/>

        <!-- what happened, in plain words -->
        <Grid Grid.Row="3" Margin="0,16,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="recentTitle" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink500}" VerticalAlignment="Center"/>
          <Button x:Name="openLogBtn" Grid.Column="1" Style="{StaticResource Link}" VerticalAlignment="Center" Click="OnOpenLog"/>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
          <Grid>
            <ScrollViewer x:Name="recentScroll" MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsControl x:Name="recentList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3,0,3" Background="Transparent" ToolTip="{Binding Full}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Tm"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource Ink400}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <Ellipse x:Name="dot" Grid.Column="1" Width="7" Height="7" Fill="#9CA3AF" Margin="0,1,9,0" VerticalAlignment="Center"/>
                      <TextBlock x:Name="line" Grid.Column="2" FontSize="12.5" Foreground="{StaticResource Ink700}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="{Binding Text, Mode=OneWay}"/><Run Text="{Binding Sub, Mode=OneWay}" Foreground="{StaticResource Ink400}"/>
                      </TextBlock>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Tone}" Value="need">
                        <Setter TargetName="dot" Property="Fill" Value="#EF4444"/>
                        <Setter TargetName="line" Property="Foreground" Value="#B91C1C"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="act">
                        <Setter TargetName="dot" Property="Fill" Value="#3B82F6"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="good">
                        <Setter TargetName="dot" Property="Fill" Value="#10B981"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Tone}" Value="warn">
                        <Setter TargetName="dot" Property="Fill" Value="#F59E0B"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="recentEmpty" Style="{StaticResource Hint}" Margin="0,4,0,4" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>
    </TabItem>

    <!-- 2. phone -->
    <TabItem x:Name="tabPhone">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,22,28,24">
          <TextBlock x:Name="notifyTitle" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="notifyHelp" Style="{StaticResource Hint}" Margin="0,5,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="webhook" TextChanged="OnWebhookChanged" LostKeyboardFocus="OnWebhookCommit"/>
            <TextBlock x:Name="webhookHint" Foreground="{StaticResource Ink400}" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="testBtn" Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnTest"/>
          </Grid>
          <TextBlock x:Name="testState" Style="{StaticResource Hint}" Margin="0,7,0,0" Visibility="Collapsed"/>
          <WrapPanel Margin="0,14,0,0">
            <CheckBox x:Name="evNeedsYou" Style="{StaticResource Check}" Margin="0,0,26,8" Click="OnEvents"/>
            <CheckBox x:Name="evDone" Style="{StaticResource Check}" Margin="0,0,26,8" Click="OnEvents"/>
            <CheckBox x:Name="evMorning" Style="{StaticResource Check}" Margin="0,0,26,8" Click="OnMorning"/>
          </WrapPanel>

          <Border Height="1" Background="{StaticResource Line}" Margin="0,14,0,22"/>

          <TextBlock x:Name="remoteTitle" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="remoteHelp" Style="{StaticResource Hint}" Margin="0,5,0,14"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Bot ID" Foreground="{StaticResource Ink700}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBox x:Name="botId" Grid.Column="1" TextChanged="OnBotEdited"/>
            <TextBlock Text="Secret" Grid.Row="1" Foreground="{StaticResource Ink700}" VerticalAlignment="Center" Margin="0,10,16,0"/>
            <PasswordBox x:Name="secret" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" PasswordChanged="OnBotEdited"/>
          </Grid>
          <WrapPanel Margin="0,14,0,0">
            <Button x:Name="connectBtn" Style="{StaticResource BtnPrimary}" Margin="0,0,16,0" Click="OnConnect"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinHeight="34">
              <Ellipse x:Name="remoteDot" Width="9" Height="9" Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,1,8,0"/>
              <TextBlock x:Name="remoteState" FontSize="12.5" Foreground="{StaticResource Ink600}" VerticalAlignment="Center"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock x:Name="remoteNote" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"/>
          <Border x:Name="pairBox" CornerRadius="10" Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource BlueLine}" BorderThickness="1"
                  Padding="18,14,18,16" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="pairLead" FontSize="12.5" Foreground="{StaticResource BlueText}" TextWrapping="Wrap"/>
              <TextBlock x:Name="pairCode" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BlueDeep}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="pairInfo" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
          <TextBlock x:Name="phoneFoot" Style="{StaticResource Foot}" Margin="0,26,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- 3. settings: the words on the left, the switch on the right -->
    <TabItem x:Name="tabSettings">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="28,10,28,24">
          <Grid Margin="0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock x:Name="startTitle" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="startHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="startChk" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" Click="OnStartup"/>
          </Grid>
          <Border Height="1" Background="{StaticResource LineSoft}"/>
          <Grid Margin="0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock x:Name="awakeTitle" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="awakeHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox x:Name="awakeChk" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" Click="OnAwake"/>
          </Grid>
          <Border Height="1" Background="{StaticResource LineSoft}"/>
          <Grid Margin="0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock x:Name="idleTitle" Style="{StaticResource RowTitle}"/>
              <TextBlock x:Name="idleHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource BtnIcon}" Content="&#xE949;" Tag="-30" Click="OnIdleStep"/>
              <TextBox x:Name="idleBox" Width="64" Margin="6,0" TextAlignment="Center" LostKeyboardFocus="OnIdleCommit" KeyDown="OnIdleKey"/>
              <Button Style="{StaticResource BtnIcon}" Content="&#xE948;" Tag="30" Click="OnIdleStep"/>
              <TextBlock x:Name="idleUnit" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Ink600}"/>
            </StackPanel>
          </Grid>
          <Border Height="1" Background="{StaticResource LineSoft}"/>
          <Grid Margin="0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="langTitle" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
              <RadioButton x:Name="langAuto" GroupName="lang" Style="{StaticResource Chip}" Margin="0" Click="OnLang"/>
              <RadioButton x:Name="langZh" GroupName="lang" Style="{StaticResource Chip}" Click="OnLang"/>
              <RadioButton x:Name="langEn" GroupName="lang" Style="{StaticResource Chip}" Click="OnLang"/>
            </WrapPanel>
          </Grid>
          <TextBlock x:Name="setFoot" Style="{StaticResource Foot}" Margin="0,22,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>

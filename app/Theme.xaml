<!-- The look of the window: the grays and blues of the sketch the user approved (Tailwind's scale), rounded
     6-10 px corners, no 3D chrome. Sizes are in WPF units (1/96 inch), so they grow with the display scale and
     text never outgrows its box. ASCII only: every word comes from config.default.json. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Ink900" Color="#111827"/>
  <SolidColorBrush x:Key="Ink700" Color="#374151"/>
  <SolidColorBrush x:Key="Ink600" Color="#4B5563"/>
  <SolidColorBrush x:Key="Ink500" Color="#6B7280"/>
  <SolidColorBrush x:Key="Ink400" Color="#9CA3AF"/>
  <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>
  <SolidColorBrush x:Key="LineSoft" Color="#F3F4F6"/>
  <SolidColorBrush x:Key="FieldLine" Color="#D1D5DB"/>
  <SolidColorBrush x:Key="Blue" Color="#2563EB"/>
  <SolidColorBrush x:Key="BlueDark" Color="#1D4ED8"/>
  <SolidColorBrush x:Key="BlueSoft" Color="#EFF6FF"/>
  <SolidColorBrush x:Key="BlueLine" Color="#BFDBFE"/>
  <SolidColorBrush x:Key="BlueText" Color="#1E40AF"/>
  <SolidColorBrush x:Key="BlueDeep" Color="#1E3A8A"/>

  <!-- keyboard focus: a soft blue ring instead of the dotted rectangle -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="8" RadiusY="8" Stroke="#2563EB" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- text -->
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Ink500}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="LineHeight" Value="19"/>
  </Style>
  <Style x:Key="Foot" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource Ink400}"/>
  </Style>
  <Style x:Key="RowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- buttons: one template; a dark veil gives hover and press for every colour -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource FieldLine}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinWidth" Value="60"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="veil" CornerRadius="6" Background="#000000" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="veil" Property="Opacity" Value="0.05"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="veil" Property="Opacity" Value="0.11"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{StaticResource Blue}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <!-- the button on a session row; asks once more before stopping (Armed) -->
  <Style x:Key="BtnRow" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="MinWidth" Value="58"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Armed}" Value="True">
        <Setter Property="Background" Value="#FEF2F2"/>
        <Setter Property="BorderBrush" Value="#FCA5A5"/>
        <Setter Property="Foreground" Value="#B91C1C"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- the minus / plus of a number box -->
  <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource Ink600}"/>
  </Style>
  <Style x:Key="Link" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Blue}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="t" Background="Transparent" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- text fields -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource FieldLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource FieldLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a check box like the sketch's: a blue rounded square with a white tick -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink700}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="17" Height="17" VerticalAlignment="Center">
              <Border x:Name="box" CornerRadius="4" BorderThickness="1.5" BorderBrush="#9CA3AF" Background="White"/>
              <Path x:Name="tick" Data="M 4.3,8.9 L 7.3,11.8 L 12.8,5.6" Stroke="White" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="#2563EB"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="#2563EB"/>
              <Setter TargetName="box" Property="BorderBrush" Value="#2563EB"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- an on/off switch for the settings rows -->
  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="42" Height="24" Background="Transparent">
            <Border x:Name="track" CornerRadius="12" Background="White" BorderBrush="#9CA3AF" BorderThickness="1.5"/>
            <Ellipse x:Name="knob" Width="12" Height="12" Fill="#6B7280" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="#4B5563"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="#2563EB"/>
              <Setter TargetName="track" Property="BorderBrush" Value="#2563EB"/>
              <Setter TargetName="knob" Property="Fill" Value="White"/>
              <Setter TargetName="knob" Property="Width" Value="14"/>
              <Setter TargetName="knob" Property="Height" Value="14"/>
              <Setter TargetName="knob" Property="Margin" Value="23,0,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- one of a few choices (the language): a rounded chip -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Ink700}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" CornerRadius="6" Background="White" BorderBrush="{StaticResource FieldLine}" BorderThickness="1" Padding="14,0" MinHeight="32">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#F9FAFB"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
              <Setter Property="Foreground" Value="#1D4ED8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the page strip: plain words, the open one blue with a bar under it -->
  <Style x:Key="Tabs" TargetType="TabControl">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,4,16,0">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Ink600}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="Transparent" Margin="0,0,4,0">
            <ContentPresenter ContentSource="Header" Margin="14,10,14,11" HorizontalAlignment="Center" RecognizesAccessKey="False"/>
            <Border x:Name="bar" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Background="{StaticResource Blue}" Margin="10,0,10,-1" Visibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource BlueDark}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- thin scroll bars: a rounded thumb, no arrows -->
  <Style x:Key="SlimThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" CornerRadius="3" Background="#D1D5DB" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="t" Property="Background" Value="#9CA3AF"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="t" Property="Background" Value="#6B7280"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
